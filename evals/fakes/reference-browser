#!/usr/bin/env python3
"""Test-only captured-reference fixture; no claim of live browser coverage."""
import argparse
import base64
import json
import os
from pathlib import Path

p = argparse.ArgumentParser()
p.add_argument('--save', required=True)
a = p.parse_args()
path = Path(a.save)
if path.is_absolute() or '..' in path.parts:
    p.error('save must be repo-relative')
path.parent.mkdir(parents=True, exist_ok=True)
# Tiny valid PNG used only as a workflow artifact, never a design reference.
path.write_bytes(base64.b64decode('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+a5WQAAAAASUVORK5CYII='))
record = {'event': 'capture', 'mockup_exists': Path('mockup.html').exists(),
          'url': 'https://example.invalid/reference', 'designer': 'Eval reference studio',
          'licence': 'Test fixture only; no reuse rights', 'file': str(path)}
with open(os.environ['FAKE_REFERENCE_LOG'], 'a') as fh:
    fh.write(json.dumps(record) + '\n')
print(json.dumps(record))
